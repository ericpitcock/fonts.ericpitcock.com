# npm user config for Netlify builds only, so the GitHub Packages token and the
# Hugeicons Pro license key reach Netlify's "Install dependencies" stage.
#
# Netlify points npm here with the site environment variable
# NPM_CONFIG_USERCONFIG=/opt/build/repo/scripts/netlify.npmrc and supplies
# VUE_APP_GITHUB_TOKEN and HUGEICONS_NPM_TOKEN. The laptop and the test server
# never read this file: without NPM_CONFIG_USERCONFIG, npm uses ~/.npmrc,
# which holds the real tokens. Putting these auth lines in the committed
# .npmrc instead would override ~/.npmrc everywhere the variables are unset,
# and every install there would 401.
@ericpitcock:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:_authToken=${VUE_APP_GITHUB_TOKEN}

@hugeicons-pro:registry=https://npm.hugeicons.com/
//npm.hugeicons.com/:_authToken=${HUGEICONS_NPM_TOKEN}
