# Registry mappings only. Tokens live in ~/.npmrc on the laptop and the test
# server, and on Netlify in scripts/netlify.npmrc. An auth line here would
# override ~/.npmrc on every machine, and 401 wherever its variable is unset
# (the test server's deploy hook did exactly that).
@ericpitcock:registry=https://npm.pkg.github.com/

# Icon artwork: Hugeicons Pro, licensed per seat and never redistributed, so
# @ericpitcock/epicenter-icons-vue ships no artwork and `postinstall` generates
# it from this package.
@hugeicons-pro:registry=https://npm.hugeicons.com/
