//npm.pkg.github.com/:_authToken=${VUE_APP_GITHUB_TOKEN}
@ericpitcock:registry=https://npm.pkg.github.com/

# Icon artwork: Hugeicons Pro, licensed per seat and never redistributed, so
# @ericpitcock/epicenter-icons-vue ships no artwork and `postinstall` generates
# it from this package. Registry mapping only. The license key comes from
# ~/.npmrc on the laptop and the test server, and on Netlify from
# scripts/netlify.npmrc (see there for why it is not a line here).
@hugeicons-pro:registry=https://npm.hugeicons.com/
